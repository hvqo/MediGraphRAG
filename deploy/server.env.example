# Leave blank until a server and domain are available. Never commit server.env.
DOMAIN=
# For your own notes only; not consumed by Compose.
SERVER_IP=

MEDIGRAPH_ALLOW_REGISTRATION=true
MEDIGRAPH_SESSION_SECONDS=604800
MEDIGRAPH_MODEL_CALLS_PER_DAY=200
MEDIGRAPH_STORAGE_MB=512
MEDIGRAPH_MAX_REQUEST_MB=50
MEDIGRAPH_MAX_PENDING_TASKS=3
MEDIGRAPH_REQUESTS_PER_MINUTE=300

# OpenAI-compatible inference endpoint reachable FROM THE CONTAINER.
# A server's 127.0.0.1 is not this container's 127.0.0.1.
MEDIGRAPH_DEFAULT_PROVIDER=openai
MEDIGRAPH_DEFAULT_API_BASE=
MEDIGRAPH_DEFAULT_API_MODEL=
MEDIGRAPH_CLOUD_API_KEY=
MEDIGRAPH_VISION_API_KEY=
MEDIGRAPH_REVIEW_API_KEY=
# Enable after copying real BGE model directories into the persistent volume.
MEDIGRAPH_DEFAULT_VECTORS=0
MEDIGRAPH_DEFAULT_RERANK=0
# Set only behind the supplied Caddy gateway; direct app ports are not published.
MEDIGRAPH_TRUST_GATEWAY=true
